# Copy to .env and adjust. .env is gitignored.

# Host directory that gets bind-mounted into the container.
DATA_DIR=./data

# Path inside the container. Leave as-is unless you know why you're changing it.
HANDOVER_ROOT=/data

# Set to true for a download-only instance (no upload, rename, move, delete).
HANDOVER_READONLY=false

# Port on the host.
HANDOVER_PORT=8100

# Owner of files the app creates. `id -u` / `id -g` on the host.
PUID=1000
PGID=1000
